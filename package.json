{
  "name": "rainer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test lib/motion.test.ts lib/reflectivity.test.ts lib/nowcast.test.ts lib/map-frame.test.ts lib/tiles.test.ts lib/places.test.ts lib/coords.test.ts lib/server/rate-limit.test.ts lib/server/http.test.ts",
    "verify": "biome check . && bun run typecheck && bun run test",
    "prepare": "husky"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
